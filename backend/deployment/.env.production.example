# Vriddhi API - Production Environment Configuration
# Copy this file to .env on your production server and update all values

# Application
APP_NAME="Vriddhi API"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_php_artisan_key:generate
APP_DEBUG=false
APP_URL=https://api.vriddhi.com

# Frontend URL (for CORS)
FRONTEND_URL=https://vriddhi.com

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vriddhi
DB_USERNAME=vriddhi_user
DB_PASSWORD=YOUR_SECURE_DATABASE_PASSWORD_HERE

# Redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=YOUR_REDIS_PASSWORD_HERE
REDIS_PORT=6379
REDIS_CLIENT=predis

# Cache & Session
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_DOMAIN=.vriddhi.com

# Queue
QUEUE_CONNECTION=redis

# Mail Configuration (Mailgun)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=YOUR_MAILGUN_USERNAME
MAIL_PASSWORD=YOUR_MAILGUN_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@vriddhi.com
MAIL_FROM_NAME="${APP_NAME}"

# Alternative: Use Mailgun API
# MAIL_MAILER=mailgun
# MAILGUN_DOMAIN=mg.vriddhi.com
# MAILGUN_SECRET=YOUR_MAILGUN_API_KEY
# MAILGUN_ENDPOINT=api.mailgun.net

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# Google OAuth
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# Cloudflare R2 Storage (S3-compatible)
AWS_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=auto
AWS_BUCKET=vriddhi-images
AWS_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=https://images.vriddhi.com

# Filesystem
FILESYSTEM_DISK=r2

# Laravel Sanctum
SANCTUM_STATEFUL_DOMAINS=vriddhi.com,www.vriddhi.com
SANCTUM_TOKEN_EXPIRATION=10080

# Logging
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Broadcasting (if needed in future)
BROADCAST_DRIVER=log

# Telescope (disable in production)
TELESCOPE_ENABLED=false

# Debugbar (disable in production)
DEBUGBAR_ENABLED=false

# Trusted Proxies (if behind load balancer)
# TRUSTED_PROXIES=*

# Security
# Set these in your web server configuration (Nginx)
# HSTS, X-Frame-Options, X-Content-Type-Options, etc.

# Rate Limiting
# Configured in routes/api.php and Nginx

# Backup (optional)
BACKUP_DISK=local
BACKUP_NOTIFICATION_EMAIL=admin@vriddhi.com

# Monitoring (optional - for services like Sentry)
# SENTRY_LARAVEL_DSN=YOUR_SENTRY_DSN
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Notes:
# 1. Never commit this file to version control
# 2. Generate APP_KEY with: php artisan key:generate
# 3. Use strong, unique passwords for database and Redis
# 4. Keep all API keys and secrets secure
# 5. Update FRONTEND_URL to match your actual frontend domain
# 6. Configure CORS in config/cors.php to match FRONTEND_URL
